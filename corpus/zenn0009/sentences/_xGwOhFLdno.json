      "sent_id": "_xGwOhFLdno:s0145",
      "video_id": "_xGwOhFLdno",
      "idx": 145,
      "start_s": 521.44,
      "end_s": 528.56,
      "text": "For the first time in history, a full-grown bull elephant could be moved.",
