    },
    {
      "sent_id": "_xGwOhFLdno:s0077",
      "video_id": "_xGwOhFLdno",
      "idx": 77,
      "start_s": 271.44,
      "end_s": 279.36,
      "text": "The rangers responded the way detectives respond to a serial case.",
      "n_words": 11
    },
    {
      "sent_id": "_xGwOhFLdno:s0078",
      "video_id": "_xGwOhFLdno",
      "idx": 78,
      "start_s": 275.199,
      "end_s": 282.963,
      "text": "They photographed every kill site and logged every set of tracks.",
      "n_words": 11
    },
    {
      "sent_id": "_xGwOhFLdno:s0079",
      "video_id": "_xGwOhFLdno",
      "idx": 79,
      "start_s": 279.36,
      "end_s": 291.52000000000004,
      "text": "When a helicopter crew caught an attack in progress, they drove the elephant off and airlifted the wounded rhino out of the park.",
      "n_words": 23
    },
    {
      "sent_id": "_xGwOhFLdno:s0080",
      "video_id": "_xGwOhFLdno",
      "idx": 80,
      "start_s": 286.8,
      "end_s": 291.52000000000004,
      "text": "It survived.",
      "n_words": 2
    },
    {
