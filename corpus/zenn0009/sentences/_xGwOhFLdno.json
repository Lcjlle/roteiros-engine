    },
    {
      "sent_id": "_xGwOhFLdno:s0139",
      "video_id": "_xGwOhFLdno",
      "idx": 139,
      "start_s": 501.599,
      "end_s": 509.03900000000004,
      "text": "It was a property of the world they'd been handed.",
