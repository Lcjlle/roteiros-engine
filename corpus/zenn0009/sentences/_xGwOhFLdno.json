    {
      "sent_id": "_xGwOhFLdno:s0147",
      "video_id": "_xGwOhFLdno",
      "idx": 147,
      "start_s": 533.92,
      "end_s": 543.2,
      "text": "They were hauled across the country, held for 3 days in an enclosure to learn what an electric fence was, and released.",
