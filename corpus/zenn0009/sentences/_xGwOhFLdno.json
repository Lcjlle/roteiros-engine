    },
    {
      "sent_id": "_xGwOhFLdno:s0138",
      "video_id": "_xGwOhFLdno",
      "idx": 138,
      "start_s": 499.84,
      "end_s": 504.71999999999997,
      "text": "The violence wasn't a property of the animals.",
