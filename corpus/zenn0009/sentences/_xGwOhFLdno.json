    },
    {
      "sent_id": "_xGwOhFLdno:s0082",
      "video_id": "_xGwOhFLdno",
      "idx": 82,
      "start_s": 289.12,
      "end_s": 295.35999999999996,
      "text": "Scouts then found three teenage bulls loitering near the scene.",
