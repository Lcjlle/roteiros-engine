      "video_id": "_xGwOhFLdno",
      "idx": 141,
      "start_s": 506.639,
      "end_s": 512.959,
      "text": "Import the missing adults.",
      "n_words": 4
    },
    {
      "sent_id": "_xGwOhFLdno:s0142",
      "video_id": "_xGwOhFLdno",
      "idx": 142,
      "start_s": 509.039,
      "end_s": 515.039,
      "text": "For 20 years, that had been physically impossible.",
      "n_words": 8
    },
    {
      "sent_id": "_xGwOhFLdno:s0143",
      "video_id": "_xGwOhFLdno",
      "idx": 143,
      "start_s": 511.12,
      "end_s": 517.5189999999999,
      "text": "It was the entire reason the orphans existed.",
