      "video_id": "_xGwOhFLdno",
      "idx": 83,
      "start_s": 291.52,
      "end_s": 301.68,
      "text": "The evidence was circumstantial and the park knew it.",
      "n_words": 9
    },
    {
      "sent_id": "_xGwOhFLdno:s0084",
      "video_id": "_xGwOhFLdno",
      "idx": 84,
      "start_s": 295.36,
      "end_s": 301.68,
      "text": "They shot all three anyway.",
      "n_words": 5
    },
    {
